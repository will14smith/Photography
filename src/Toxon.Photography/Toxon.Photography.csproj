<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
	  <AWSProjectType>Lambda</AWSProjectType>
	  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

	  <PublishReadyToRun>true</PublishReadyToRun>
	  <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.1.0" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.100.3" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.101.1" />
    <PackageReference Include="AWSSDK.EventBridge" Version="4.0.100.3" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.100.3" />
    <PackageReference Include="AWSSDK.Lambda" Version="4.0.102" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toxon.Photography.Generation\Toxon.Photography.Generation.csproj" />
    <ProjectReference Include="..\Toxon.Photography.Data\Toxon.Photography.Data.csproj" />
    <ProjectReference Include="..\Toxon.Photography.ImageProcessing\Toxon.Photography.ImageProcessing.csproj" />
  </ItemGroup>

</Project>
